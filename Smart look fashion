name: Build SMART LOOK FASHION APK

on:
  push:
    paths:
      - '**'
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Download repository files
        uses: actions/checkout@v4

      - name: Extract Android project
        run: |
          unzip SMART_LOOK_FASHION_Android_Project.zip -d android-project

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Set up Gradle
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Build Android APK
        run: |
          cd android-project/SMART_LOOK_FASHION_Android_Project
          gradle assembleDebug

      - name: Save APK
        uses: actions/upload-artifact@v4
        with:
          name: SMART-LOOK-FASHION-APK
          path: android-project/SMART_LOOK_FASHION_Android_Project/app/build/outputs/apk/debug/app-debug.apk
